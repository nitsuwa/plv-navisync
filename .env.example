VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ── Demo login (login page only) ────────────────────────────────────────────
# Shows the "Demo Account" dropdown on the login page when enabled and at
# least one demo email is set:
#   VITE_ENABLE_DEMO_LOGIN   exactly "true"
#   VITE_DEMO_ADMIN_EMAIL    a disposable demo admin account email
#   VITE_DEMO_ADMIN_PASSWORD that disposable admin account's password
#   VITE_DEMO_STUDENT_EMAIL  a disposable demo student account email
#   VITE_DEMO_STUDENT_PASSWORD that disposable student account's password
# The dropdown fills both fields. All VITE_* values are embedded in the public
# browser bundle, so these passwords must belong only to disposable demo users.
# Sign-in still goes through Supabase. Each option appears independently and
# both still require VITE_ENABLE_DEMO_LOGIN="true".
# Keep these blank unless you are preparing a demonstration. Never put a real
# administrator account here; only disposable demo accounts.
VITE_ENABLE_DEMO_LOGIN=
VITE_DEMO_ADMIN_EMAIL=
VITE_DEMO_ADMIN_PASSWORD=
VITE_DEMO_STUDENT_EMAIL=
VITE_DEMO_STUDENT_PASSWORD=
