VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ── Demo login (login page only) ────────────────────────────────────────────
# Shows the "Demo Account" dropdown on the login page when ALL of these are set:
#   VITE_ENABLE_DEMO_LOGIN   exactly "true"
#   VITE_DEMO_ADMIN_EMAIL    a disposable demo admin account email
#   VITE_DEMO_ADMIN_PASSWORD the matching demo admin password
#   VITE_DEMO_STUDENT_EMAIL  a disposable demo student account email
#   VITE_DEMO_STUDENT_PASSWORD the matching demo student password
# The dropdown only fills the login form — sign-in still goes through Supabase.
# Each demo option appears independently: the Admin option needs the admin
# variables; the Student option needs only the student variables. Both still
# require VITE_ENABLE_DEMO_LOGIN="true".
# Keep these blank unless you are preparing a demonstration. Never put a real
# administrator account here; only disposable demo accounts.
VITE_ENABLE_DEMO_LOGIN=
VITE_DEMO_ADMIN_EMAIL=
VITE_DEMO_ADMIN_PASSWORD=
VITE_DEMO_STUDENT_EMAIL=
VITE_DEMO_STUDENT_PASSWORD=
