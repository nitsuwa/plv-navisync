# PLV NaviSync — Demo account provisioning (developer-only)
# ----------------------------------------------------------------------------
# Copy this file to `.env.demo.local`, fill in the real values, then run:
#
#     pnpm demo:accounts
#
# `.env.demo.local` is gitignored — never commit it and never paste its values
# into chat. The service-role key must never be used in frontend code.
#
# ── Supabase project ──────────────────────────────────────────────────────
# Find these in the Supabase Dashboard → Project Settings → API.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Existing administrator (authorizes the demo admin role promotion) ──────
# The existing role='admin' account whose session performs the demo admin
# promotion through the normal authorized workflow (RLS + trigger preserved).
EXISTING_ADMIN_EMAIL=
EXISTING_ADMIN_PASSWORD=

# ── Demo accounts created by `pnpm demo:accounts` ──────────────────────────
# Emails/passwords are chosen by the developer and supplied only through this
# local file. They are never hardcoded and never shown on the login page.
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
DEMO_STUDENT_EMAIL=
DEMO_STUDENT_PASSWORD=
