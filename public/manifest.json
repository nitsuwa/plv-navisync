{
  "name": "PLV NaviSync — Smart Campus Navigator",
  "short_name": "PLV NaviSync",
  "description": "Interactive campus map and navigation for Pamantasan ng Lungsod ng Valenzuela. Find buildings, get directions, explore floor plans, and receive campus announcements — all in one app.",
  "start_url": "/map",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#081943",
  "theme_color": "#0e2a6e",
  "categories": [
    "education",
    "navigation",
    "maps",
    "utilities"
  ],
  "lang": "en-PH",
  "dir": "ltr",
  "scope": "/",
  "id": "/map",
  "launch_handler": {
    "client_mode": [
      "navigate-existing",
      "auto"
    ]
  },
  "edge_side_panel": {
    "preferred_width": 360
  },
  "icons": [
    {
      "src": "/icon-48x48.png",
      "sizes": "48x48",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon-maskable-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "webapp",
      "url": "/manifest.json"
    }
  ],
  "shortcuts": [
    {
      "name": "Open Campus Map",
      "short_name": "Map",
      "description": "Interactive campus map with directions and building details",
      "url": "/map",
      "icons": [
        {
          "src": "/icon-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Buildings Directory",
      "short_name": "Buildings",
      "description": "Browse campus buildings, rooms, and facilities",
      "url": "/buildings",
      "icons": [
        {
          "src": "/icon-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "My Profile",
      "short_name": "Profile",
      "description": "Student profile, favorites, and settings",
      "url": "/student",
      "icons": [
        {
          "src": "/icon-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}
